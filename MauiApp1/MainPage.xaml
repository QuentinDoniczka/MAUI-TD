<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.MainPage"
             x:DataType="vm:GameViewModel"
             Title="Morpion">

    <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="20">

        <Label
            Text="Historique des victoires"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding HistoryText}"
            FontSize="16"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding StatusText}"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Grid
            RowDefinitions="100,100,100"
            ColumnDefinitions="100,100,100"
            RowSpacing="4"
            ColumnSpacing="4"
            HorizontalOptions="Center">

            <Button x:Name="Cell0" Grid.Row="0" Grid.Column="0" Command="{Binding PlayCellCommand}" CommandParameter="0" FontSize="40" FontAttributes="Bold" />
            <Button x:Name="Cell1" Grid.Row="0" Grid.Column="1" Command="{Binding PlayCellCommand}" CommandParameter="1" FontSize="40" FontAttributes="Bold" />
            <Button x:Name="Cell2" Grid.Row="0" Grid.Column="2" Command="{Binding PlayCellCommand}" CommandParameter="2" FontSize="40" FontAttributes="Bold" />

            <Button x:Name="Cell3" Grid.Row="1" Grid.Column="0" Command="{Binding PlayCellCommand}" CommandParameter="3" FontSize="40" FontAttributes="Bold" />
            <Button x:Name="Cell4" Grid.Row="1" Grid.Column="1" Command="{Binding PlayCellCommand}" CommandParameter="4" FontSize="40" FontAttributes="Bold" />
            <Button x:Name="Cell5" Grid.Row="1" Grid.Column="2" Command="{Binding PlayCellCommand}" CommandParameter="5" FontSize="40" FontAttributes="Bold" />

            <Button x:Name="Cell6" Grid.Row="2" Grid.Column="0" Command="{Binding PlayCellCommand}" CommandParameter="6" FontSize="40" FontAttributes="Bold" />
            <Button x:Name="Cell7" Grid.Row="2" Grid.Column="1" Command="{Binding PlayCellCommand}" CommandParameter="7" FontSize="40" FontAttributes="Bold" />
            <Button x:Name="Cell8" Grid.Row="2" Grid.Column="2" Command="{Binding PlayCellCommand}" CommandParameter="8" FontSize="40" FontAttributes="Bold" />

        </Grid>

        <Button
            Text="Recommencer"
            Command="{Binding ResetCommand}"
            HorizontalOptions="Center"
            FontSize="18" />

    </VerticalStackLayout>

</ContentPage>
