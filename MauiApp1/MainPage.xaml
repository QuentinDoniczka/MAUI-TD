<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.MainPage"
             x:DataType="vm:GameViewModel"
             Title="Morpion">

    <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="20">

        <Label
            Text="Historique des victoires"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding HistoryText}"
            FontSize="16"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding StatusText}"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Grid
            x:Name="BoardGrid"
            RowDefinitions="100,100,100"
            ColumnDefinitions="100,100,100"
            RowSpacing="4"
            ColumnSpacing="4"
            HorizontalOptions="Center">

            <Button Grid.Row="0" Grid.Column="0" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />
            <Button Grid.Row="0" Grid.Column="1" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />
            <Button Grid.Row="0" Grid.Column="2" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />

            <Button Grid.Row="1" Grid.Column="0" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />
            <Button Grid.Row="1" Grid.Column="1" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />
            <Button Grid.Row="1" Grid.Column="2" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />

            <Button Grid.Row="2" Grid.Column="0" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />
            <Button Grid.Row="2" Grid.Column="1" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />
            <Button Grid.Row="2" Grid.Column="2" Clicked="OnCellClicked" FontSize="40" FontAttributes="Bold" />

        </Grid>

        <Button
            Text="Recommencer"
            Command="{Binding ResetCommand}"
            HorizontalOptions="Center"
            FontSize="18" />

    </VerticalStackLayout>

</ContentPage>
